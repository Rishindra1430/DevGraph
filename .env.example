# CognoDB Connection Settings (compatible with official Neo4j Bolt driver)
NEO4J_URI=bolt+s://your-instance.cognodb.com:7687
NEO4J_USERNAME=cognodb
NEO4J_PASSWORD=your-secure-password
NEO4J_DATABASE=neo4j

# Server Settings
PORT=5000
CORS_ORIGIN=...
# GitHub API token (used to increase rate limit during seeding)
GITHUB_TOKEN=your-github-personal-access-token
